# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# Capacitor native build artifacts
# android/ and ios/ ARE committed — they contain native config, icons, and gradle files.
# Only generated build outputs and machine-local files are excluded here.
.gradle/

# Android build output (generated by Gradle)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/*.log
android/app/*.log

# iOS build output (generated by Xcode / CocoaPods)
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/DerivedData/
ios/*.xcarchive
ios/*.ipa
ios/App/App/public/
ios/App/build/

# Environment — NEVER commit these
.env
.env.local
.env.production
.env*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code
.claude/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env*
hs_err_pid*.log
replay_pid*.log
